# TenderBD environment variables. Copy to .env for local development.
# Never commit a real .env file. Values marked "set in Render" belong in
# the Render dashboard, not in this repo.
#
# Every variable in SPEC.md section 12 is listed here, plus the
# optional scraper tuning variables from tenderbd_scraper/config.py.

# --- Database ---
# Production Postgres URL (Supabase free tier). Create the Supabase
# project, copy its connection string, and paste it in the Render
# dashboard (and as the DATABASE_URL GitHub Actions secret for the
# scheduled scraper). Local dev: leave unset to use SQLite instead.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Local dev only: path of the SQLite file used when DATABASE_URL is
# unset. Default: tenderbd.db in the repo root.
TENDERBD_SQLITE_PATH=tenderbd.db

# --- Admin access ---
# Comma-separated list of emails that get is_admin=true on signup.
# Default is the three MAS addresses below.
ADMIN_EMAILS=mashkursakib@gmail.com,info@masconsultancy.org,masconsultancybd@gmail.com

# --- Refresh endpoint guard ---
# Required. Random secret guarding POST /api/v1/refresh (sent as the
# X-Refresh-Token header). Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value in the Render dashboard. No default exists.
REFRESH_TOKEN=change-me-to-a-long-random-string

# --- Email (optional) ---
# Resend API key. Enables password-reset emails. When unset, reset
# requests still return the generic success message but no email is
# sent. Get the key from the Resend dashboard (MAS account).
RESEND_API_KEY=re_...

# --- Public URL ---
# Public base URL of the deployed portal. Used in password-reset links.
APP_BASE_URL=https://tender.masconsultancy.org

# --- Port ---
# Provided by Render in production. Locally, uvicorn defaults to 8000;
# set this only if you need a different local port.
PORT=8000

# --- Scraper tuning (all optional; defaults in tenderbd_scraper/config.py) ---
# Log level for scraper runs: DEBUG, INFO, WARNING, ERROR.
TENDERBD_LOG_LEVEL=INFO
# Seconds to wait between requests to e-GP. Keep at 2 or higher.
TENDERBD_REQUEST_DELAY=2.0
# Per-request timeout in seconds.
TENDERBD_REQUEST_TIMEOUT=30.0
# Retries per failed request (exponential backoff: 2s, 4s, 8s).
TENDERBD_MAX_RETRIES=3
# Max search-result pages fetched per scraper run (10 rows per page).
TENDERBD_MAX_SEARCH_PAGES=50
# Max notice-detail pages fetched per scraper run.
TENDERBD_MAX_DETAIL_FETCHES=100
# Default publish-date lookback window in days for `scrape run`.
TENDERBD_LOOKBACK_DAYS=2
